<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 访问面板服务 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 下载文件（API 29 起公共 Downloads 目录无需权限，仅旧版本声明） -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- 下载完成 / 告警本地通知（Android 13+） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 自动更新：安装下载好的 APK -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 生物识别解锁（API 28+ BiometricPrompt） -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission
        android:name="android.permission.USE_FINGERPRINT"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ServerPanel"
        android:usesCleartextTraffic="true"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.ServerPanel.Launch"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ServerPickerActivity"
            android:exported="false"
            android:label="@string/server_picker_title"
            android:theme="@style/Theme.ServerPanel" />

        <activity
            android:name=".DownloadsActivity"
            android:exported="false"
            android:label="@string/downloads_title"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.ServerPanel" />

        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:label="@string/chat_title"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.ServerPanel"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".DshSessionActivity"
            android:exported="false"
            android:label="@string/chat_dsh_session_title"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.ServerPanel" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.ServerPanel"
            android:windowSoftInputMode="adjustResize" />

        <!-- 自动更新：把 App 私有目录里的 APK 通过 content:// 交给系统安装器 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 桌面小组件：CPU / 内存 / 温度 / 负载 -->
        <receiver
            android:name=".MetricsWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
    </application>

</manifest>
