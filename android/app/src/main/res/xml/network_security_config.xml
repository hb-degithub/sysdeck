<?xml version="1.0" encoding="utf-8"?>
<!-- 面板走局域网明文 http://；HTTPS/tailnet 由系统信任链校验 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
