# 依赖（本项目设计为零 npm 依赖，保留以防万一）
node_modules/
pnpm-lock.yaml
package-lock.json

# 运行时数据
data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.log

# 本地配置（含 token，绝不入库）
config.json
config.local.json
*.local.json

# 临时文件
tmp/
.cache/
*.pid
*.sock

# 编辑器
.vscode/
.idea/
*.swp
.DS_Store

# Android 工具链与构建产物（用户态安装，不入库）
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/keystore/
*.jks
*.keystore

# APK 产物（由 scripts/build-android.sh 重新生成）
dist/

# 本机 DSH 模型路由补丁（含个人 provider 配置，不入库；模板见 config/dsh-headless.patch.example.yml）
config/dsh-headless.patch.yml

# 本机部署记录（含个人 IP/路径，不入库）
docs/DEPLOY-local.md

# 界面截图（含本机信息，暂不公开）
docs/shots/
